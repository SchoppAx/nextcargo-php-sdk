{
  "name": "schoppax/nexcargo-php-sdk",
  "version": "1.0.0",
  "description": "PHP SDK for the NexCargo (Camel Cloud API) carrier integration",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "schoppax",
      "email": "schoppax@example.com"
    }
  ],
  "homepage": "https://github.com/schoppax/nextcargo-php-sdk",
  "repository": {
    "type": "git",
    "url": "https://github.com/schoppax/nextcargo-php-sdk.git"
  },
  "require": {
    "php": "^8.2",
    "guzzlehttp/guzzle": "^8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.3",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "NexCargo\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "NexCargo\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse -c phpstan.neon"
  }
}
